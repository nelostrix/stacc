// Example RSS robot description — a quadcopter drone, mirroring stacc's
// own `drone` CLI template. Each `rotor` is a thrust actuator at a corner of
// the body: `thrust:` is its maximum (N), `spin:` defaults to the X-quad
// pattern (front-left and rear-right counter-clockwise), and the yaw reaction
// torque per newton is `torque_ratio:` (default 0.016 m). Command thrust with
// the runtime API's {"thrusts": [N, ...]} (front_left, front_right,
// rear_left, rear_right order).
robot drone {
    body {
        shape: box;
        material: carbon_fiber;
        dimensions: [220mm, 220mm, 60mm];
        mass: 1kg;
        color: "#101010";
    }

    rotor front_left  { thrust: 6N; radius: 64mm; actuator: bldc; }
    rotor front_right { thrust: 6N; radius: 64mm; actuator: bldc; }
    rotor rear_left   { thrust: 6N; radius: 64mm; actuator: bldc; }
    rotor rear_right  { thrust: 6N; radius: 64mm; actuator: bldc; }

    sensors {
        imu body {
            model: bmi088;
            rate: 400hz;
        }

        gps top {
            model: ublox-m9n;
        }

        camera front {
            model: runcam-nano;
            fov: 150deg;
        }
    }

    navigation {
        algorithm: px4-ekf2;
        max_speed: 15m/s;
    }
}
